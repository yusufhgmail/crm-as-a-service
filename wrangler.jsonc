{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-native",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "crmfromwithin.com", "custom_domain": true },
    { "pattern": "www.crmfromwithin.com", "custom_domain": true },
    { "pattern": "crmfromwithin.ai", "custom_domain": true },
    { "pattern": "www.crmfromwithin.ai", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "crm-that-fits-leads",
      "database_id": "c05de698-d0cd-4508-afb8-b68eab6f12a8",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ASSESSMENT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 15,
        "period": 60
      }
    },
    {
      "name": "FUNNEL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
